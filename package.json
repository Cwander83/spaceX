{
  "name": "spacex",
  "version": "1.0.0",
  "description": "App that lists SpaceX missions",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node --test test/*.test.js"
  },
  "author": "Chris Wander",
  "license": "ISC",
  "homepage": "https://cwander83.github.io/spaceX",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-http": "^1.23.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
